{
  "name": "full-access-mcp-server",
  "version": "0.1.0",
  "description": "Full-access Streamable HTTP MCP server for file, shell, process, and browser control.",
  "private": true,
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "gateway:dev": "tsx watch src/gatewayIndex.ts",
    "gateway:start": "node dist/src/gatewayIndex.js",
    "gateway:cli": "tsx src/scripts/gatewayClient.ts",
    "agent:dev": "tsx watch src/agentIndex.ts",
    "agent:start": "node dist/src/agentIndex.js",
    "runtime:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .tools/runtime-stack.ps1 start",
    "runtime:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .tools/runtime-stack.ps1 stop",
    "runtime:restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .tools/runtime-stack.ps1 restart",
    "runtime:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .tools/runtime-stack.ps1 status",
    "developer-mode:print": "tsx src/scripts/printDeveloperModeRegistration.ts",
    "chatgpt:inspect": "tsx src/scripts/inspectCurrentChatGptPage.ts",
    "bridge:token": "tsx src/scripts/generateLocalBridgeToken.ts",
    "install:browsers": "playwright install chromium",
    "test": "tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "streamable-http",
    "playwright",
    "filesystem",
    "shell"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "jose": "^6.2.2",
    "playwright": "^1.58.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}

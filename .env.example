# Supported public deployment path:
# ChatGPT Developer Mode -> remote gateway -> local workstation agent.
# Do not enable the legacy localhost bridge for a new deployment.

# Local workstation runtime
WORKSPACE_ROOTS=.
ALLOW_COMPUTER_WIDE_ACCESS=false
COMMAND_OUTPUT_LIMIT=250000
PROCESS_SESSION_IDLE_TTL_MS=1800000
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_STORAGE_ROOT=.full-access-mcp/browser
CHROME_EXECUTABLE=
CHROME_DEVTOOLS_USER_DATA_DIR=
CHROME_REMOTE_DEBUGGING_AUTO_ALLOW_ENABLED=true
CHROME_REMOTE_DEBUGGING_AUTO_ALLOW_POLL_INTERVAL_MS=750
CHATGPT_MCP_AUTO_ALLOW_ENABLED=false
CHATGPT_MCP_AUTO_ALLOW_POLL_INTERVAL_MS=1000

# Remote gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9797
GATEWAY_CORS_ORIGIN=*
GATEWAY_HTTP_REQUEST_BODY_LIMIT_BYTES=512000
GATEWAY_ALLOW_LOOPBACK_DEBUG_BYPASS=false
GATEWAY_MCP_AUTH_TOKEN=
GATEWAY_TOOL_CALL_TIMEOUT_MS=300000
GATEWAY_AGENT_POLL_TIMEOUT_MS=25000
GATEWAY_AGENT_STALE_AFTER_MS=60000
PUBLIC_GATEWAY_BASE_URL=https://YOUR-NGROK-DOMAIN.ngrok-free.app
NGROK_AUTOSTART=false
NGROK_URL=YOUR-NGROK-DOMAIN.ngrok-free.app
NGROK_EXECUTABLE=C:\\Path\\To\\ngrok.exe

# OAuth / OIDC (Auth0 recommended)
OIDC_ISSUER_URL=https://YOUR-AUTH0-TENANT.us.auth0.com/
OIDC_AUDIENCE=https://YOUR-NGROK-DOMAIN.ngrok-free.app/mcp
OIDC_REQUIRED_SCOPES=mcp.full_access
OIDC_ALLOWED_SUBJECTS=
OIDC_ALLOWED_EMAILS=

# Optional read-only surface
READ_ONLY_PUBLIC_GATEWAY_BASE_URL=https://YOUR-NGROK-DOMAIN.ngrok-free.app
READ_ONLY_OIDC_ISSUER_URL=
READ_ONLY_OIDC_AUDIENCE=
READ_ONLY_OIDC_REQUIRED_SCOPES=
READ_ONLY_OIDC_ALLOWED_SUBJECTS=
READ_ONLY_OIDC_ALLOWED_EMAILS=
READ_ONLY_GATEWAY_MCP_AUTH_TOKEN=

# Gateway <-> agent authentication
REMOTE_WORKSTATION_ID=workstation-1
REMOTE_WORKSTATION_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Local agent
AGENT_GATEWAY_BASE_URL=http://127.0.0.1:9797
AGENT_POLL_RETRY_DELAY_MS=2000

# Legacy localhost bridge path. Keep disabled for the supported public setup.
LOCAL_BRIDGE_ENABLED=false
